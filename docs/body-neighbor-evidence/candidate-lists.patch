diff --git a/src/physics/BodyCandidateLists.ts b/src/physics/BodyCandidateLists.ts
new file mode 100644
--- /dev/null
+++ b/src/physics/BodyCandidateLists.ts
@@ -0,0 +1,110 @@
+import type { Vector3 } from 'three';
+import type { PreparedBodyCollider } from './CapeBodyColliderPreparation';
+
+// One-step neighbour lists. Bounds are necessary conditions of the unchanged
+// narrowphase, expanded by skin; they also cover its one-sided front contacts.
+export const BODY_CANDIDATE_SKIN = 0.026;
+export const bodyCandidateMetrics = { vertexBuilds: 0, vertexRebuilds: 0, vertexCandidates: 0, vertexWorst: 0, triangleBuilds: 0, triangleRebuilds: 0, triangleCandidates: 0, triangleWorst: 0, overflows: 0, vertexRebuildWorst: 0, triangleRebuildWorst: 0, vertexSkippedAssertions: 0, triangleSkippedAssertions: 0 };
+export const bodyCandidateDebug = { enabled: true, assertions: false, skin: BODY_CANDIDATE_SKIN };
+export class VertexBodyCandidates {
+  private readonly reference: Float64Array;
+  private readonly masks: Uint32Array;
+  private readonly valid: Uint8Array;
+  private readonly builds: Uint16Array;
+  public constructor(particles: number) {
+    this.builds = new Uint16Array(particles);
+    this.reference = new Float64Array(particles * 3);
+    this.masks = new Uint32Array(particles);
+    this.valid = new Uint8Array(particles);
+  }
+  public beginStep(): void { this.valid.fill(0); this.builds.fill(0); }
+  public mask(index: number, point: Vector3, colliders: readonly PreparedBodyCollider[]): number {
+    if (colliders.length > 32) {
+      if (!this.valid[index]) { bodyCandidateMetrics.overflows++; this.valid[index] = 1; }
+      return 0xffffffff;
+    }
+    const offset = index * 3, skin = bodyCandidateDebug.skin;
+    const dx = point.x - this.reference[offset]!, dy = point.y - this.reference[offset + 1]!, dz = point.z - this.reference[offset + 2]!;
+    if (this.valid[index] && dx * dx + dy * dy + dz * dz < skin * skin) return this.masks[index]!;
+    let mask = 0;
+    for (let candidate = 0; candidate < colliders.length; candidate++) {
+      const collider = colliders[candidate]!, radius = Math.max(collider.lateralRadius, collider.depthRadius) + 1e-7 + skin;
+      const x = point.x - collider.startX, z = point.z - collider.startZ;
+      if (point.y >= collider.minimumY - skin && point.y <= collider.maximumY + skin
+        && x >= Math.min(0, collider.axisX) - radius && x <= Math.max(0, collider.axisX) + radius
+        && z >= Math.min(0, collider.axisZ) - radius && z <= Math.max(0, collider.axisZ) + radius) mask |= 1 << candidate;
+    }
+    bodyCandidateMetrics.vertexBuilds++;
+    if (this.valid[index]) bodyCandidateMetrics.vertexRebuilds++;
+    this.builds[index] = this.builds[index]! + 1; bodyCandidateMetrics.vertexRebuildWorst = Math.max(bodyCandidateMetrics.vertexRebuildWorst, this.builds[index]!);
+    let count = 0; for (let bits = mask >>> 0; bits; bits = (bits & (bits - 1)) >>> 0) count++;
+    bodyCandidateMetrics.vertexCandidates += count; bodyCandidateMetrics.vertexWorst = Math.max(bodyCandidateMetrics.vertexWorst, count);
+    this.reference[offset] = point.x; this.reference[offset + 1] = point.y; this.reference[offset + 2] = point.z;
+    this.valid[index] = 1; this.masks[index] = mask;
+    return mask;
+  }
+}
+
+export class TriangleBodyCandidates {
+  public readonly samples = new Float64Array(128 * 4);
+  public sampleCount = 0;
+  private readonly references: Float64Array;
+  private readonly masks: Uint32Array;
+  private readonly dirty: Uint8Array;
+  private readonly valid: Uint8Array;
+  private readonly builds: Uint16Array;
+  public constructor(triangles: number) {
+    this.builds = new Uint16Array(triangles);
+    this.references = new Float64Array(triangles * 9);
+    this.masks = new Uint32Array(triangles * 4);
+    this.dirty = new Uint8Array(triangles);
+    this.valid = new Uint8Array(triangles);
+  }
+  public beginStep(): void { this.valid.fill(0); this.builds.fill(0); this.sampleCount = 0; }
+  public beginRun(): void { this.dirty.fill(1); }
+  public changed(triangle: number): void { this.dirty[triangle] = 1; }
+  public includes(triangle: number, sample: number, a: Vector3, b: Vector3, c: Vector3): boolean {
+    if (this.sampleCount > 128) {
+      if (!this.valid[triangle]) { bodyCandidateMetrics.overflows++; this.valid[triangle] = 1; }
+      return true;
+    }
+    if (this.dirty[triangle]) {
+      this.dirty[triangle] = 0;
+      const base = triangle * 9, skin = bodyCandidateDebug.skin, squared = skin * skin;
+      let moved = !this.valid[triangle];
+      for (let vertex = 0; vertex < 3 && !moved; vertex++) {
+        const point = vertex === 0 ? a : vertex === 1 ? b : c, offset = base + vertex * 3;
+        const x = point.x - this.references[offset]!, y = point.y - this.references[offset + 1]!, z = point.z - this.references[offset + 2]!;
+        moved = x * x + y * y + z * z >= squared;
+      }
+      if (moved) {
+        bodyCandidateMetrics.triangleBuilds++;
+        if (this.valid[triangle]) bodyCandidateMetrics.triangleRebuilds++;
+        this.builds[triangle] = this.builds[triangle]! + 1; bodyCandidateMetrics.triangleRebuildWorst = Math.max(bodyCandidateMetrics.triangleRebuildWorst, this.builds[triangle]!);
+        let count = 0;
+        const maskBase = triangle * 4;
+        this.masks.fill(0, maskBase, maskBase + 4);
+        const minX = Math.min(a.x, b.x, c.x) - skin - 1e-7, maxX = Math.max(a.x, b.x, c.x) + skin + 1e-7;
+        const minY = Math.min(a.y, b.y, c.y) - skin - 1e-7, maxY = Math.max(a.y, b.y, c.y) + skin + 1e-7;
+        const minZ = Math.min(a.z, b.z, c.z) - skin - 1e-7, maxZ = Math.max(a.z, b.z, c.z) + skin + 1e-7;
+        for (let candidate = 0; candidate < this.sampleCount; candidate++) {
+          const offset = candidate * 4, x = this.samples[offset]!, y = this.samples[offset + 1]!, z = this.samples[offset + 2]!, radius = this.samples[offset + 3]!;
+          if (x + radius >= minX && x - radius <= maxX
+            && y + radius >= minY && y - radius <= maxY
+            && z + radius >= minZ && z - radius <= maxZ) {
+            count++;
+            const word = maskBase + (candidate >>> 5);
+            this.masks[word] = this.masks[word]! | (1 << (candidate & 31));
+          }
+        }
+        for (let vertex = 0; vertex < 3; vertex++) {
+          const point = vertex === 0 ? a : vertex === 1 ? b : c, offset = base + vertex * 3;
+          this.references[offset] = point.x; this.references[offset + 1] = point.y; this.references[offset + 2] = point.z;
+        }
+        bodyCandidateMetrics.triangleCandidates += count; bodyCandidateMetrics.triangleWorst = Math.max(bodyCandidateMetrics.triangleWorst, count);
+        this.valid[triangle] = 1;
+      }
+    }
+    return (this.masks[triangle * 4 + (sample >>> 5)]! & (1 << (sample & 31))) !== 0;
+  }
+}
