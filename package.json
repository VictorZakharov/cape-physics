{
  "name": "cape-physics",
  "private": true,
  "version": "1.0.0",
  "description": "A cinematic procedural cape-physics tech demo set in a living cave.",
  "homepage": "https://victorzakharov.github.io/cape-physics/",
  "repository": {
    "type": "git",
    "url": "https://github.com/VictorZakharov/cape-physics.git"
  },
  "bugs": {
    "url": "https://github.com/VictorZakharov/cape-physics/issues"
  },
  "keywords": [
    "threejs",
    "typescript",
    "webgpu",
    "webgl",
    "tsl",
    "cloth-simulation",
    "position-based-dynamics",
    "physics-simulation",
    "procedural-generation",
    "game-development"
  ],
  "license": "MIT",
  "author": "Victor Zakharov",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/cape-physics/",
    "check:pages": "node scripts/check-pages-build.mjs",
    "check:size": "bun scripts/check-source-size.ts",
    "test": "bun test --timeout 30000",
    "check": "bun run check:size && tsc --noEmit && bun test --timeout 30000",
    "harness": "bun scripts/verify-tech-demo.ts",
    "stress:rocks": "bun scripts/run-rock-stress.ts",
    "audit:visual": "bun run build && bun scripts/render-visual-audit.mjs",
    "probe:webgpu": "bun run build && bun scripts/run-webgpu-isolation-probe.mjs",
    "profile:render": "bun run build && bun scripts/render-performance-profile.mjs",
    "audit:cape-trajectories": "bun run build && bun scripts/compare-cape-trajectories.mjs",
    "verify": "bun run check && bun run build && bun run harness",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/three": "0.185.4",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "bun": ">=1.3.11"
  }
}
